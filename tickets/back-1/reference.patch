@@ -0,0 +1,52 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { resetDatabase } from './db.ts';
+import { useApi } from './test/app.ts';
+
+const { api, db } = useApi();
+
+const product = { name: 'Fig Jam', description: 'Small batch.', priceCents: 675, stock: 5, categoryId: null };
+const search = async (q: string) => (await api().get('/api/products').query({ q })).body;
+
+describe('the price of a product', () => {
+  beforeEach(async () => {
+    await resetDatabase(db());
+  });
+
+  it.each([-500, -1, 4.5, '675', null, Number.MAX_SAFE_INTEGER])('refuses %j when a product is created, and stores nothing', async (priceCents) => {
+    const response = await api()
+      .post('/api/products')
+      .send({ ...product, priceCents });
+
+    expect(response.status).toBe(400);
+    expect(response.body.error).toBe('Invalid product');
+    expect(Object.keys(response.body.fields)).toEqual(['priceCents']);
+    expect((await search('fig jam')).total).toBe(0);
+  });
+
+  it('refuses a product without a price', async () => {
+    const { priceCents: _priceCents, ...withoutPrice } = product;
+    const response = await api().post('/api/products').send(withoutPrice);
+
+    expect(response.status).toBe(400);
+    expect(Object.keys(response.body.fields)).toEqual(['priceCents']);
+  });
+
+  it.each([-500, 4.5, '675'])('refuses %j when a product is changed, and keeps the old price', async (priceCents) => {
+    const [loaf] = (await search('sourdough loaf')).items;
+    const response = await api().patch(`/api/products/${loaf.id}`).send({ priceCents });
+
+    expect(response.status).toBe(400);
+    expect(Object.keys(response.body.fields)).toEqual(['priceCents']);
+    expect((await search('sourdough loaf')).items[0].priceCents).toBe(450);
+  });
+
+  it('accepts zero and whole cents', async () => {
+    for (const priceCents of [0, 1, 675]) {
+      const response = await api()
+        .post('/api/products')
+        .send({ ...product, name: `Fig Jam ${priceCents}`, priceCents });
+
+      expect(response.status).toBe(201);
+    }
+  });
+});
