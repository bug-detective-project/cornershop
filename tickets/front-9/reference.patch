diff --git a/client/src/pages/Admin.price.test.tsx b/client/src/pages/Admin.price.test.tsx
new file mode 100644
index 0000000..00ed34c
--- /dev/null
+++ b/client/src/pages/Admin.price.test.tsx
@@ -0,0 +1,58 @@
+import { screen, waitFor, within } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { describe, expect, it } from 'vitest';
+import { mockApi } from '../test/mockApi.ts';
+import { renderApp } from '../test/renderApp.tsx';
+
+const rows = () => screen.findAllByTestId('admin-product');
+const price = () => screen.getByRole('textbox', { name: 'Price' });
+
+describe('the price field of the owner panel', () => {
+  it('takes the digits from the right, as cents, like the price filters', async () => {
+    mockApi();
+    renderApp('/admin');
+    await rows();
+
+    await userEvent.type(price(), '4');
+    expect(price()).toHaveValue('$0.04');
+    await userEvent.type(price(), '5');
+    expect(price()).toHaveValue('$0.45');
+    await userEvent.type(price(), '0');
+    expect(price()).toHaveValue('$4.50');
+  });
+
+  it('ignores what is not a digit, takes the last digit out with Backspace, and shows the number keys on a phone', async () => {
+    mockApi();
+    renderApp('/admin');
+    await rows();
+
+    await userEvent.type(price(), '1a2,3.4');
+    expect(price()).toHaveValue('$12.34');
+    await userEvent.type(price(), '{Backspace}');
+    expect(price()).toHaveValue('$1.23');
+    expect(price()).toHaveAttribute('inputmode', 'numeric');
+  });
+
+  it('shows the price of the product to edit with the mask', async () => {
+    mockApi();
+    renderApp('/admin');
+    await rows();
+
+    await userEvent.click(screen.getByRole('button', { name: 'Edit Whole Milk' }));
+
+    expect(price()).toHaveValue('$1.89');
+  });
+
+  it('saves the price typed with the mask in cents', async () => {
+    const { requests } = mockApi();
+    renderApp('/admin');
+    await rows();
+
+    await userEvent.type(screen.getByLabelText('Name'), 'Fig Jam');
+    await userEvent.type(price(), '450');
+    await userEvent.click(screen.getByRole('button', { name: 'Save' }));
+
+    await waitFor(() => expect(requests.find((request) => request.method === 'POST')).toMatchObject({ body: { name: 'Fig Jam', priceCents: 450 } }));
+    await waitFor(async () => expect(within((await rows())[0]!).getByText('$4.50')).toBeInTheDocument());
+  });
+});
